# Reference template only: the application does not auto-load .env. Export values into the process environment.
SMARTMASK_ENVIRONMENT=development
SMARTMASK_SOURCE_DB_URL=sqlite:///./data/demo_source.db
SMARTMASK_CONTROL_DB_URL=sqlite:///./data/control.db
SMARTMASK_MAX_SAMPLE_ROWS=50
SMARTMASK_MAX_QUERY_LIMIT=100
SMARTMASK_DEFAULT_QUERY_LIMIT=20

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# API startup requires at least 32 random bytes.
SMARTMASK_JWT_SECRET=
SMARTMASK_JWT_ALGORITHM=HS256
SMARTMASK_JWT_ISSUER=smartmask
SMARTMASK_JWT_AUDIENCE=smartmask-api
SMARTMASK_JWT_LIFETIME_MINUTES=15
SMARTMASK_API_HOST=127.0.0.1
SMARTMASK_API_PORT=8000
SMARTMASK_API_DOCS=true
SMARTMASK_CORS_ORIGINS=
SMARTMASK_TRUSTED_HOSTS=

# Dashboard calls only the API; do not point it at an untrusted host.
SMARTMASK_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Optional PostgreSQL source, using a least-privilege read-only account.
SMARTMASK_POSTGRES_DB_URL=
SMARTMASK_POSTGRES_SCHEMA=public
SMARTMASK_POSTGRES_CONNECT_TIMEOUT=5

# Required only for Analyst pseudonymization; independent of JWT signing key.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SMARTMASK_HMAC_SECRET=
SMARTMASK_LOG_LEVEL=INFO
