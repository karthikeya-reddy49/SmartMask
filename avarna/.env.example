# Reference template only: the application does not auto-load .env. Export values into the process environment.
AVARNA_ENVIRONMENT=development
AVARNA_SOURCE_DB_URL=sqlite:///./data/demo_source.db
AVARNA_CONTROL_DB_URL=sqlite:///./data/control.db
AVARNA_MAX_SAMPLE_ROWS=50
AVARNA_MAX_QUERY_LIMIT=100
AVARNA_DEFAULT_QUERY_LIMIT=20

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# API startup requires at least 32 random bytes.
AVARNA_JWT_SECRET=
AVARNA_JWT_ALGORITHM=HS256
AVARNA_JWT_ISSUER=avarna
AVARNA_JWT_AUDIENCE=avarna-api
AVARNA_JWT_LIFETIME_MINUTES=15
AVARNA_API_HOST=127.0.0.1
AVARNA_API_PORT=8000
AVARNA_API_DOCS=true
AVARNA_CORS_ORIGINS=
AVARNA_TRUSTED_HOSTS=

# Dashboard calls only the API; do not point it at an untrusted host.
AVARNA_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Optional PostgreSQL source, using a least-privilege read-only account.
AVARNA_POSTGRES_DB_URL=
AVARNA_POSTGRES_SCHEMA=public
AVARNA_POSTGRES_CONNECT_TIMEOUT=5

# Required only for Analyst pseudonymization; independent of JWT signing key.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AVARNA_HMAC_SECRET=
AVARNA_LOG_LEVEL=INFO
